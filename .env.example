MONGODB_URI=mongodb://127.0.0.1:27017/nobroker_clone
JWT_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Set true only on a disposable development database before seeding.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=ChangeThisDemo123!

# Express Backend Integration
# Set to 'true' to proxy API calls to the Express backend
# Set to 'false' to use the Next.js internal API
USE_EXPRESS_BACKEND=true
EXPRESS_BACKEND_URL=http://127.0.0.1:5000

# ── MAP PROVIDER CONFIGURATION (OPTIONAL) ──
# UrbanFindr comes with free CartoDB Voyager and OpenStreetMap tiles out-of-the-box (no key needed).
# To use your own commercial tile providers, add your API keys below:
# Mapbox: https://account.mapbox.com/ (e.g., pk.eyJ1Ij...)
NEXT_PUBLIC_MAPBOX_TOKEN=
# MapTiler: https://cloud.maptiler.com/
NEXT_PUBLIC_MAPTILER_KEY=
# Google Maps Platform: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Stadia Maps: https://stadiamaps.com/
NEXT_PUBLIC_STADIA_API_KEY=
